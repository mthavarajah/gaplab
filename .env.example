# Keep these server-side. Use paper credentials with the paper trading base URL.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Existing ALPACA_SECRET_KEY and ALPACA_DATA_FEED aliases are also accepted.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
# SIP covers multiple exchanges; IEX is one venue with sparse extended hours.
ALPACA_FEED=sip
# Delayed historical SIP: 16-minute buffer; snapshots use delayed_sip (15 minutes).
# Use 0 only with real-time SIP entitlement. Never silently switch feeds.
ALPACA_DELAY_MINUTES=16
# Neon pooled Postgres URL (or standard Postgres connection string).
DATABASE_URL=
# Optional explicit start for Max available. Actual coverage depends on feed/account.
ALPACA_HISTORY_START=2016-01-04
